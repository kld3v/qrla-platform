container_commands:
    01_make_executable:
        command: chmod +x .platform/hooks/postdeploy/*.sh
        command: chmod +x .platform/hooks/prebuild/*.sh
        command: chmod +x .platform/hooks/predeploy/*.sh


    02_ensure_unix_format:
        command: dos2unix .platform/hooks/postdeploy/*.sh
        command: dos2unix .platform/hooks/prebuild/*.sh
        command: dos2unix .platform/hooks/predeploy/*.sh

    03_ensure_cache_directory_exists:
        command: rm -rf /tmp/nginx_cache && mkdir /tmp/nginx_cache
